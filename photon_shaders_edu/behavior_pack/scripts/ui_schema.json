        { "type": "toggle", "key": "sky", "label": "Sky Rendering", "default": true },
        { "type": "toggle", "key": "fog", "label": "Fog Effects", "default": true },
        { "type": "toggle", "key": "volumetric", "label": "Volumetric Lighting", "default": true },
        { "type": "toggle", "key": "clouds", "label": "Cloud Rendering", "default": true },
        { "type": "slider", "key": "fogDensity", "label": "Fog Density", "min": 0.0, "max": 1.0, "step": 0.1, "default": 0.5 }
      ]
    }
