        { "type": "toggle", "key": "lighting", "label": "Global Illumination", "default": true },
        { "type": "toggle", "key": "ambientOcclusion", "label": "Ambient Occlusion", "default": true },
        { "type": "toggle", "key": "bloom", "label": "Bloom", "default": true },
        { "type": "slider", "key": "shadows", "label": "Shadow Distance", "min": 64, "max": 512, "step": 8, "default": 256 }
      ]
    },
    "presets": {
      "title": "Photon Presets",
      "options": [
        { "id": "competitive", "label": "Competitive", "description": "Fast & clear" },
        { "id": "balanced", "label": "Balanced", "description": "Best quality/performance" },
        { "id": "cinematic", "label": "Cinematic", "description": "Maximum quality" },
        { "id": "fantasy", "label": "Fantasy", "description": "Artistic colors" }
      ]
    },
    "water": {
      "title": "Water Settings",
      "fields": [
        { "type": "dropdown", "key": "waterQuality", "label": "Water Quality", "options": ["Low", "Medium", "High", "Ultra"], "default": 2 },
        { "type": "toggle", "key": "waves", "label": "Wave Simulation", "default": true },
